      pin(clkin) {  /* clock input */
         direction : input; 
         capacitance : 0.0445;
         max_transition : 1.350;
		 related_power_pin : vpwri;
		 related_ground_pin : vgnd;
		 clock : true;
		 min_pulse_width_high : 4.0000;
		 min_pulse_width_low : 4.0000;
		 min_period : 10.0000;

		 internal_power() {
            when : "(pd' * sleep')";
			rise_power(clk_energy_1x5) {
               index_1 ("0.0100, 0.3000, 0.5000, 1.0000, 1.5000");
			   values (\
			           "6.5007, 6.5007, 6.5007, 6.5007, 6.5007" \
			   )
			}
			fall_power(clk_energy_1x5) {
               index_1 ("0.0100, 0.3000, 0.5000, 1.0000, 1.5000");
			   values (\
			           "6.5007, 6.5007, 6.5007, 6.5007, 6.5007" \
			   )
			}
		 }

		 internal_power() {
            when : "(pd' * sleep)";
			rise_power(clk_energy_1x5) {
               index_1 ("0.0100, 0.3000, 0.5000, 1.0000, 1.5000");
			   values (\
			           "0.3118, 0.3118, 0.3118, 0.3118, 0.3118" \
			   )
			}
			fall_power(clk_energy_1x5) {
               index_1 ("0.0100, 0.3000, 0.5000, 1.0000, 1.5000");
			   values (\
			           "0.3118, 0.3118, 0.3118, 0.3118, 0.3118" \
			   )
			}
		 }
      } 

      bus (clk) {
      bus_type : BUSA_4_0;
         pin(clk[4]) {
            direction : output; 
            max_transition : 5;
            max_capacitance : 0.450;
		    related_power_pin : vpwri;
		    related_ground_pin : vgnd;
            timing() { /* SEL4[3:0]=01h -> TAP0 */
			   when : "(SEL4[3]' * SEL4[2]' * SEL4[1]' * SEL4[0])"; 
               sdf_cond : "(~SEL4[3] * ~SEL4[2] * ~SEL4[1] * SEL4[0])";
               timing_sense : positive_unate;
               cell_rise(clk_delay_3x4) { 
                  values ( \
				     "2.944, 3.049, 3.216, 3.492 ",\
				     "3.063, 3.169, 3.335, 3.602 ",\
				     "3.092, 3.187, 3.353, 3.631 ");
               } 
               rise_transition(clk_transition_1x4) { 
                  values ("0.073, 0.183, 0.386, 0.748");
               }
               cell_fall(clk_delay_3x4) { 
                  values ( \
				     "3.171, 3.327, 3.531, 3.857 ",\
				     "3.399, 3.558, 3.761, 4.092 ",\
				     "3.479, 3.634, 3.840, 4.162 ");
               } 
               fall_transition(clk_transition_1x4) { 
                  values ("0.086, 0.224, 0.459, 0.861");
               }
               related_pin : "clkin";
            }
            timing() { /* SEL4[3:0]=02h -> TAP1 */
			   when : "(SEL4[3]' * SEL4[2]' * SEL4[1] * SEL4[0]')"; 
