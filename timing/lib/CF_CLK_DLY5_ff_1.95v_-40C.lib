      pin(clkin) {  /* clock input */
         direction : input; 
         capacitance : 0.0445;
         max_transition : 1.350;
		 related_power_pin : vpwri;
		 related_ground_pin : vgnd;
		 clock : true;
		 min_pulse_width_high : 4.0000;
		 min_pulse_width_low : 4.0000;
		 min_period : 10.0000;

		 internal_power() {
            when : "(pd' * sleep')";
			rise_power(clk_energy_1x5) {
               index_1 ("0.0100, 0.3000, 0.5000, 1.0000, 1.5000");
			   values (\
			           "7.9593, 7.9593, 7.9593, 7.9593, 7.9593" \
			   )
			}
			fall_power(clk_energy_1x5) {
               index_1 ("0.0100, 0.3000, 0.5000, 1.0000, 1.5000");
			   values (\
			           "7.9593, 7.9593, 7.9593, 7.9593, 7.9593" \
			   )
			}
		 }

		 internal_power() {
            when : "(pd' * sleep)";
			rise_power(clk_energy_1x5) {
               index_1 ("0.0100, 0.3000, 0.5000, 1.0000, 1.5000");
			   values (\
			           "0.3837, 0.3837, 0.3837, 0.3837, 0.3837" \
			   )
			}
			fall_power(clk_energy_1x5) {
               index_1 ("0.0100, 0.3000, 0.5000, 1.0000, 1.5000");
			   values (\
			           "0.3837, 0.3837, 0.3837, 0.3837, 0.3837" \
			   )
			}
		 }
      } 

