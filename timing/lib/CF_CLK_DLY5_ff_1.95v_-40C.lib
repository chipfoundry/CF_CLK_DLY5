/*********************************************************
*   FEB 1, 2008 ORIGINAL ISSUE
*   REV 1.1  2/16/08 library name change: CF_CLK_DLY5 -> CF_CLK_DLY5_ff_1.95v_-40C
*   REV 1.2  3/21/08 commented out cell_leakage_power : 100, area : 1.00
*   REV 2.0  4/10/08 CDT22357 fix
*                    (1) area, (2) leakages, (3) add internal power to clock input, (4) analog pin comment, (5) input cap, (6) max cap, (7) min cap
*   REV 2.1 11/03/08 updated max_trans and max_cap values
*   REV 2.2  1/12/09 CDT34926 fix (1) add sleep control signal
*                    CDT35812 fix (2) internal & leakage power update
*   REV 2.3 11/14/09 AIP error fix 
*
*   CORNER INFO:  FF 1.95V -40C
*********************************************************/

library (CF_CLK_DLY5_ff_1.95v_-40C) {
   technology (cmos);
   delay_model : table_lookup;
   voltage_unit : "1V";
   current_unit : "1mA";
   leakage_power_unit : "1nW";
   default_inout_pin_cap : 0.0;
   default_input_pin_cap : 0.0;
   default_output_pin_cap : 0.0;
   default_fanout_load : 0.0;
   default_cell_leakage_power : 0.0;
   default_leakage_power_density : 0.0;
   capacitive_load_unit (1,pf);
   bus_naming_style : "%s[%d]";
   pulling_resistance_unit : "1kohm";
   input_threshold_pct_rise : 50.0;
   input_threshold_pct_fall : 50.0;
   output_threshold_pct_rise : 50.0;
   output_threshold_pct_fall : 50.0;
   slew_lower_threshold_pct_fall : 20.0;
   slew_lower_threshold_pct_rise : 20.0;
   slew_upper_threshold_pct_fall : 80.0;
   slew_upper_threshold_pct_rise : 80.0;
   time_unit : "1ns";
   voltage_map(vpwr, 1.95);
   voltage_map(vpwri, 1.95);
   voltage_map(vgnd, 0.0);
   voltage_map(vpb, 1.95);
   voltage_map(vnb, 0.0);

   library_features (report_delay_calculation);

   nom_process : 1.0;
   nom_temperature : -40.0;
   nom_voltage : 1.95;

   operating_conditions (min) {
      process : 1.0;
 	  temperature : -40.0;
	  voltage : 1.95;
	  tree_type : best_case_tree;
   }

   default_operating_conditions : min;

   type (BUSA_4_0) {
     base_type   : array;
     data_type   : bit;
     bit_width   : 5;
     bit_from    : 4;
     bit_to      : 0;
     downto      : true;
   }

   type (BUSA_3_0) {
     base_type  : array;
     data_type   : bit;
     bit_width   : 4;
     bit_from    : 3;
     bit_to      : 0;
     downto      : true;
   }

   lu_table_template (clk_delay_3x4) { 
      variable_1 : input_net_transition; 
      variable_2 : total_output_net_capacitance; 
      index_1 ("0.01, 1.00, 1.50");
      index_2 ("0.010, 0.100, 0.250, 0.500");
   }

   lu_table_template(clk_transition_1x4) { 
      variable_1 : total_output_net_capacitance; 
      index_1 ("0.010, 0.100, 0.250, 0.500");
   }

   power_lut_template(clk_energy_1x5) {
      variable_1 : input_transition_time;
	  index_1 ("0.0100, 0.3000, 0.5000, 1.0000, 1.5000");
   }

   /* CF_CLK_DLY5 */

   cell (CF_CLK_DLY5) {

	  leakage_power() {  /* leakage power when pd enable */
	     when : "pd";
		 value : 8.88186;  /* leak.cor, 1.95V, 100C */
		 related_pg_pin : vpwr;
	  }

	  leakage_power() {  /* pd & sleep disable */
	     when : "(pd' * sleep')";
		 value : 30377;  
		 related_pg_pin : vpwr;
	  }

	  leakage_power() {  
	     when : "(pd' * sleep)";
		 value : 6.825;  
		 related_pg_pin : vpwr;
	  }

      cell_leakage_power :  8.88186;

      area : 15934.00; 

      interface_timing : true;

      pg_pin(vpwr) { 
         voltage_name : vpwr;  
         pg_type : primary_power;  
      } 

      pg_pin(vpwri) { 
         voltage_name : vpwri;  
         pg_type : internal_power;  
      } 

      pg_pin(vpb) { 
         voltage_name : vpb;  
         pg_type : primary_power;  
      } 

      pg_pin(vnb) { 
         voltage_name : vnb;  
         pg_type : primary_ground;  
      } 

      pg_pin(vgnd) { 
         voltage_name : vgnd;  
         pg_type : primary_ground;  
      }

      bus(trim) { 
         bus_type : "BUSA_4_0"; 
         direction : input;
	     related_power_pin : vpwri;
	     related_ground_pin : vgnd;
		 pin(trim[4]) {
            max_transition : 5.000;
            capacitance : 0.1310;
		 }
		 pin(trim[3]) {
            max_transition : 5.000;
		    capacitance : 0.0690;
		 }
		 pin(trim[2]) {
            max_transition : 5.000;
		    capacitance : 0.0378;
		 }
		 pin(trim[1]) {
            max_transition : 5.000;
		    capacitance : 0.0222;
		 }
		 pin(trim[0]) {
            max_transition : 5.000;
		    capacitance : 0.0127;
		 }
      } 

      pin(pd) { 
         direction : input; 
         capacitance : 1.342;   
         max_transition : 5.000;
		 related_power_pin : vpwr;
		 related_ground_pin : vgnd;
      } 

      pin(sleep) { 
         direction : input; 
         capacitance : 0.113;   
         max_transition : 5.000;
		 related_power_pin : vpwri;
		 related_ground_pin : vgnd;
      } 

      pin(isel) { 
         direction : input; 
         capacitance : 0.0212;   
         max_transition : 5.000;
		 related_power_pin : vpwri;
		 related_ground_pin : vgnd;
      } 

      pin(iref) { /* analog pin - bandgap ref current */ 
         direction : input; 
         capacitance : 0.0163;   
         max_transition : 5.000;
		 related_power_pin : vpwri;
		 related_ground_pin : vgnd;
      } 

      pin(ctrim1) { 
         direction : input; 
         capacitance : 0.0102;   
         max_transition : 5.000;
		 related_power_pin : vpwri;
		 related_ground_pin : vgnd;
      } 

      pin(ctrim0) { 
         direction : input; 
         capacitance : 0.0106;   
         max_transition : 5.000;
		 related_power_pin : vpwri;
		 related_ground_pin : vgnd;
      } 

      pin(clkmode) { 
         direction : input; 
         capacitance : 0.0232;   
         max_transition : 5.000;
		 related_power_pin : vpwri;
		 related_ground_pin : vgnd;
      }

      pin(reset) { 
