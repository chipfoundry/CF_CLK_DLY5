         pin(clk[4]) {
            direction : output; 
            max_transition : 5;
            max_capacitance : 0.450;
		    related_power_pin : vpwri;
		    related_ground_pin : vgnd;
            timing() { /* SEL4[3:0]=01h -> TAP0 */
			   when : "(SEL4[3]' * SEL4[2]' * SEL4[1]' * SEL4[0])"; 
               sdf_cond : "(~SEL4[3] * ~SEL4[2] * ~SEL4[1] * SEL4[0])";
               timing_sense : positive_unate;
               cell_rise(clk_delay_3x4) { 
                  values ( \
				     "2.390, 2.460, 2.574, 2.763 ",\
					 "2.433, 2.500, 2.613, 2.803 ",\
					 "2.438, 2.505, 2.618, 2.808 ");
               } 
               rise_transition(clk_transition_1x4) { 
                  values ("0.051, 0.136, 0.272, 0.526");
               }
               cell_fall(clk_delay_3x4) { 
                  values ( \
				     "2.163, 2.263, 2.398, 2.614 ",\
					 "2.337, 2.434, 2.573, 2.790 ",\
					 "2.388, 2.492, 2.628, 2.840 ");
               } 
               fall_transition(clk_transition_1x4) { 
                  values ("0.060, 0.153, 0.317, 0.582");
               }
               related_pin : "clkin";
            }
