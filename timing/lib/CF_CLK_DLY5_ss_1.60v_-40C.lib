      pin(clkin) {  /* clock input */
         direction : input; 
         capacitance : 0.0445;
         max_transition : 1.350;
		 related_power_pin : vpwri;
		 related_ground_pin : vgnd;
		 clock : true;
		 min_pulse_width_high : 4.0000;
		 min_pulse_width_low : 4.0000;
		 min_period : 10.0000;

		 internal_power() {
            when : "(pd' * sleep')";
			rise_power(clk_energy_1x5) {
               index_1 ("0.0100, 0.3000, 0.5000, 1.0000, 1.5000");
			   values (\
			           "4.7598, 4.7598, 4.7598, 4.7598, 4.7598" \
			   )
			}
			fall_power(clk_energy_1x5) {
               index_1 ("0.0100, 0.3000, 0.5000, 1.0000, 1.5000");
			   values (\
			           "4.7598, 4.7598, 4.7598, 4.7598, 4.7598" \
			   )
			}
		 }

		 internal_power() {
            when : "(pd' * sleep)";
			rise_power(clk_energy_1x5) {
               index_1 ("0.0100, 0.3000, 0.5000, 1.0000, 1.5000");
			   values (\
			           "0.2445, 0.2445, 0.2445, 0.2445, 0.2445" \
			   )
			}
			fall_power(clk_energy_1x5) {
               index_1 ("0.0100, 0.3000, 0.5000, 1.0000, 1.5000");
			   values (\
			           "0.2445, 0.2445, 0.2445, 0.2445, 0.2445" \
			   )
			}
		 }
      } 

      bus (clk) {
      bus_type : BUSA_4_0;
         pin(clk[4]) {
            direction : output; 
            max_transition : 5;
            max_capacitance : 0.450;
		    related_power_pin : vpwri;
		    related_ground_pin : vgnd;
            timing() { /* SEL4[3:0]=01h -> TAP0 */
			   when : "(SEL4[3]' * SEL4[2]' * SEL4[1]' * SEL4[0])"; 
               sdf_cond : "(~SEL4[3] * ~SEL4[2] * ~SEL4[1] * SEL4[0])";
               timing_sense : positive_unate;
               cell_rise(clk_delay_3x4) { 
                  values ( \
				     "4.458, 4.689, 5.074, 5.749 ",\
					 "4.699, 4.924, 5.309, 5.978 ",\
					 "4.782, 5.013, 5.415, 6.068 ");
               } 
               rise_transition(clk_transition_1x4) { 
                  values ("0.119, 0.385, 0.863, 1.720");
               }
               cell_fall(clk_delay_3x4) { 
                  values ( \
				     "5.980, 6.248, 6.612, 7.229 ",\
					 "6.311, 6.574, 6.969, 7.573 ",\
					 "6.495, 6.763, 7.134, 7.752 ");
               } 
               fall_transition(clk_transition_1x4) { 
                  values ("0.142, 0.347, 0.685, 1.307");
               }
               related_pin : "clkin";
            }
            timing() { /* SEL4[3:0]=02h -> TAP1 */
			   when : "(SEL4[3]' * SEL4[2]' * SEL4[1] * SEL4[0]')"; 
